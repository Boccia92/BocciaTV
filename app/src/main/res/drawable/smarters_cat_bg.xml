<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 1. Cursore telecomando / Focus attivo: Bordo dorato identico a Film -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="#26FFD600" />
            <stroke android:width="3dp" android:color="#FFD600" />
        </shape>
    </item>

    <!-- 2. Categoria o canale sintonizzato / attivo -->
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="#1AFFD600" />
            <stroke android:width="2dp" android:color="#FFD600" />
        </shape>
    </item>

    <!-- 3. A riposo: Completamente trasparente, nessuna cornice o sfondo -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</selector>