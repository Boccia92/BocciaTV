<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="VPN BocciaTV"
        android:textColor="@android:color/white"
        android:textSize="32sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp"/>

    <LinearLayout
        android:layout_width="480dp"
        android:layout_height="wrap_content"
        android:background="#22FFFFFF"
        android:padding="24dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <!-- Status indicator -->
        <TextView
            android:id="@+id/tv_vpn_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Stato: Disconnessa"
            android:textColor="#FF5252"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <ProgressBar
            android:id="@+id/pb_vpn_loading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:layout_marginBottom="16dp"/>

        <!-- Country Selection Label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Seleziona Nazionalità / Paese:"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:layout_marginBottom="8dp"/>

        <!-- Country Spinner -->
        <Spinner
            android:id="@+id/sp_countries"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@android:drawable/btn_dropdown"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:focusable="true"
            android:clickable="true"
            android:layout_marginBottom="24dp"/>

        <!-- Buttons -->
        <Button
            android:id="@+id/btn_vpn_connect"
            style="@style/MenuButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CONNETTI VPN"
            android:textColor="#4CAF50"
            android:focusable="true"
            android:clickable="true"/>

        <Button
            android:id="@+id/btn_vpn_disconnect"
            style="@style/MenuButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="DISCONNETTI VPN"
            android:textColor="#FF5252"
            android:visibility="gone"
            android:focusable="true"
            android:clickable="true"/>

    </LinearLayout>

    <Button
        android:id="@+id/btn_vpn_back"
        style="@style/MenuButtonStyle"
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Torna Indietro"
        android:focusable="true"
        android:clickable="true"/>

</LinearLayout>
