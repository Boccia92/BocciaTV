<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/exo_controller_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <!-- Integrated Bottom Overlay Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="#E60A0A0A"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="16dp">

        <!-- 1. Top Seekbar Line: Position | Progress | Duration -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@id/exo_position"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                android:text="00:00:00" />

            <androidx.media3.ui.DefaultTimeBar
                android:id="@id/exo_progress"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:focusable="true"
                android:clickable="true"
                android:nextFocusDown="@+id/btn_play_pause"
                app:bar_height="5dp"
                app:buffered_color="#55FFFFFF"
                app:played_color="#FFC107"
                app:scrubber_color="#FFC107"
                app:unplayed_color="#33FFFFFF" />

            <TextView
                android:id="@id/exo_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                android:text="00:00:00" />

        </LinearLayout>

        <!-- 2. Bottom Area: Poster + EPG/Metadata Info (Left) and Action Buttons (Right) -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical">

            <!-- Left: Poster + Title and Metadata -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_toStartOf="@id/ll_action_buttons"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/iv_epg_poster"
                    android:layout_width="48dp"
                    android:layout_height="64dp"
                    android:background="#22FFFFFF"
                    android:scaleType="centerCrop"
                    android:src="@drawable/movie"
                    android:contentDescription="Locandina Contenuto" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_epg_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Canale TV"
                        android:textColor="@android:color/white"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_epg_info"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:alpha="0.8"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:text="In onda: Caricamento EPG..."
                        android:textColor="#FFC107"
                        android:textSize="12sp" />

                </LinearLayout>

            </LinearLayout>

            <!-- Right: Action Buttons Row -->
            <LinearLayout
                android:id="@+id/ll_action_buttons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_epg_guide"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/player_button_focus_selector"
                    android:focusable="true"
                    android:clickable="true"
                    android:text="📺 Guida TV"
                    android:textColor="@android:color/white"
                    android:textSize="12sp"
                    android:paddingHorizontal="10dp"
                    android:nextFocusRight="@+id/btn_reminder"/>

                <Button
                    android:id="@+id/btn_reminder"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/player_button_focus_selector"
                    android:focusable="true"
                    android:clickable="true"
                    android:text="🔔 Ricorda"
                    android:textColor="@android:color/white"
                    android:textSize="12sp"
                    android:paddingHorizontal="10dp"
                    android:nextFocusLeft="@+id/btn_epg_guide"
                    android:nextFocusRight="@id/exo_rew"/>

                <ImageButton
                    android:id="@id/exo_rew"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:padding="8dp"
                    android:focusable="true"
                    android:clickable="true"
                    android:background="@drawable/player_button_focus_selector"
                    android:src="@android:drawable/ic_media_rew"
                    app:tint="@android:color/white"
                    android:contentDescription="Indietro 10s"
                    android:nextFocusLeft="@+id/btn_reminder"
                    android:nextFocusRight="@+id/btn_play_pause"/>

                <ImageButton
                    android:id="@+id/btn_play_pause"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:layout_marginStart="8dp"
                    android:padding="8dp"
                    android:focusable="true"
                    android:clickable="true"
                    android:background="@drawable/player_button_focus_selector"
                    android:src="@android:drawable/ic_media_pause"
                    app:tint="@android:color/white"
                    android:contentDescription="Play/Pausa"
                    android:nextFocusLeft="@id/exo_rew"
                    android:nextFocusRight="@id/exo_ffwd"/>

                <ImageButton
                    android:id="@id/exo_ffwd"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="8dp"
                    android:padding="8dp"
                    android:focusable="true"
                    android:clickable="true"
                    android:background="@drawable/player_button_focus_selector"
                    android:src="@android:drawable/ic_media_ff"
                    app:tint="@android:color/white"
                    android:contentDescription="Avanti 10s"
                    android:nextFocusLeft="@+id/btn_play_pause"
                    android:nextFocusRight="@+id/btn_custom_zoom"/>

                <ImageButton
                    android:id="@+id/btn_custom_zoom"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="8dp"
                    android:padding="8dp"
                    android:focusable="true"
                    android:clickable="true"
                    android:background="@drawable/player_button_focus_selector"
                    android:src="@android:drawable/ic_menu_crop"
                    app:tint="@android:color/white"
                    android:contentDescription="Zoom / Formato Video"
                    android:nextFocusLeft="@id/exo_ffwd"
                    android:nextFocusRight="@+id/btn_custom_subtitles"/>

                <ImageButton
                    android:id="@+id/btn_custom_subtitles"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="8dp"
                    android:padding="8dp"
                    android:focusable="true"
                    android:clickable="true"
                    android:background="@drawable/player_button_focus_selector"
                    android:src="@android:drawable/ic_menu_manage"
                    app:tint="@android:color/white"
                    android:contentDescription="Sottotitoli"
                    android:nextFocusLeft="@+id/btn_custom_zoom"
                    android:nextFocusRight="@+id/btn_custom_settings"/>

                <ImageButton
                    android:id="@+id/btn_custom_settings"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="8dp"
                    android:padding="8dp"
                    android:focusable="true"
                    android:clickable="true"
                    android:background="@drawable/player_button_focus_selector"
                    android:src="@drawable/ic_settings"
                    app:tint="@android:color/white"
                    android:contentDescription="Impostazioni Video"
                    android:nextFocusLeft="@+id/btn_custom_subtitles"/>

            </LinearLayout>

        </RelativeLayout>

    </LinearLayout>

</RelativeLayout>
