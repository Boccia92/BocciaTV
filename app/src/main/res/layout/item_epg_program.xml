<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="12dp"
    android:layout_marginBottom="6dp"
    android:background="@drawable/card_background"
    android:focusable="false"
    android:clickable="false">

    <TextView
        android:id="@+id/tv_epg_time"
        android:layout_width="140dp"
        android:layout_height="wrap_content"
        android:text="14:00 - 15:30"
        android:textColor="#FFC107"
        android:textSize="14sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical"
        android:focusable="false">

        <TextView
            android:id="@+id/tv_epg_prog_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Titolo Programma"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_epg_prog_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Descrizione del programma..."
            android:textColor="#DDDDDD"
            android:textSize="13sp"
            android:maxLines="3"
            android:ellipsize="end" />

    </LinearLayout>

    <Button
        android:id="@+id/btn_item_reminder"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="12dp"
        android:background="@drawable/player_button_focus_selector"
        android:text="🔔 Ricorda"
        android:textColor="@android:color/white"
        android:textSize="12sp"
        android:focusable="true"
        android:clickable="true" />

</LinearLayout>
