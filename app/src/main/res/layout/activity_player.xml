<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- EPG Channel Info Overlay at Bottom -->
    <LinearLayout
        android:id="@+id/ll_epg_overlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#CC000000"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <!-- Channel Title -->
        <TextView
            android:id="@+id/tv_epg_channel_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Canale"
            android:textColor="@android:color/white"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Current Program Title -->
        <TextView
            android:id="@+id/tv_epg_current_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="In onda: Caricamento EPG..."
            android:textColor="#FFC107"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Time / Duration -->
        <TextView
            android:id="@+id/tv_epg_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="--:-- - --:--"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:alpha="0.8" />

        <!-- Program Description -->
        <TextView
            android:id="@+id/tv_epg_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:text=""
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:alpha="0.9" />

        <!-- Next Program -->
        <TextView
            android:id="@+id/tv_epg_next_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text=""
            android:textColor="#B0BEC5"
            android:textSize="14sp" />

    </LinearLayout>

</FrameLayout>
