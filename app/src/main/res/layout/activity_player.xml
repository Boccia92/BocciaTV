<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:keepScreenOn="true"
    android:background="@android:color/black">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:keepScreenOn="true"
        app:controller_layout_id="@layout/exo_player_control_view"
        app:show_timeout="5000" />

    <!-- Salta Sigla Floating Button (Bottom Right) -->
    <Button
        android:id="@+id/btn_skip_intro"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="40dp"
        android:layout_marginBottom="90dp"
        android:background="@drawable/button_selector"
        android:text="⏭ Salta Sigla"
        android:textColor="@android:color/white"
        android:textSize="14sp"
        android:textStyle="bold"
        android:paddingHorizontal="16dp"
        android:visibility="gone"
        android:focusable="true"
        android:clickable="true" />

    <!-- Next Episode Binge Watching Overlay (Bottom Right) -->
    <LinearLayout
        android:id="@+id/ll_next_episode_overlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="40dp"
        android:layout_marginBottom="90dp"
        android:background="#CC000000"
        android:padding="16dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone"
        android:focusable="false">

        <TextView
            android:id="@+id/tv_next_episode_countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Prossimo episodio in 10s..."
            android:textColor="@android:color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginEnd="16dp" />

        <Button
            android:id="@+id/btn_play_next_episode"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/button_selector"
            android:text="Riproduci Ora"
            android:textColor="@android:color/white"
            android:textSize="13sp"
            android:focusable="true"
            android:clickable="true" />

    </LinearLayout>

</FrameLayout>
