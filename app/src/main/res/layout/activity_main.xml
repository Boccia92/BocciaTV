<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101010">

    <!-- Background Image -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_dashboard"
        android:alpha="0.45" />

    <!-- Top Left Title & Clock -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_margin="32dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Boccia TV"
            android:textColor="@android:color/white"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="EEEE d MMMM, HH:mm"
            android:format24Hour="EEEE d MMMM, HH:mm"
            android:timeZone="Europe/Rome"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:alpha="0.8" />
    </LinearLayout>

    <!-- Top Right: Info and Refresh -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentTop="true"
        android:layout_margin="32dp"
        android:gravity="end"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_exp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Scadenza: --/--/----"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_refresh"
            style="@style/MenuButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginTop="8dp"
            android:text="Aggiorna Lista"
            android:textSize="12sp"/>

        <Button
            android:id="@+id/btn_settings"
            style="@style/MenuButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginTop="8dp"
            android:text="Impostazioni"
            android:textSize="12sp"
            android:drawableStart="@drawable/ic_settings"
            android:drawablePadding="8dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"/>

    </LinearLayout>

    <!-- Central Menu -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_live"
            style="@style/MenuButtonStyle"
            android:layout_width="220dp"
            android:layout_height="180dp"
            android:text="LIVE TV"
            android:drawableTop="@drawable/ic_live"
            android:drawablePadding="12dp"
            android:paddingTop="24dp"/>

        <Button
            android:id="@+id/btn_vod"
            style="@style/MenuButtonStyle"
            android:layout_width="220dp"
            android:layout_height="180dp"
            android:layout_marginStart="24dp"
            android:text="FILM"
            android:drawableTop="@drawable/ic_movie"
            android:drawablePadding="12dp"
            android:paddingTop="24dp"/>

        <Button
            android:id="@+id/btn_series"
            style="@style/MenuButtonStyle"
            android:layout_width="220dp"
            android:layout_height="180dp"
            android:layout_marginStart="24dp"
            android:text="SERIE TV"
            android:drawableTop="@drawable/ic_series"
            android:drawablePadding="12dp"
            android:paddingTop="24dp"/>

    </LinearLayout>

</RelativeLayout>
