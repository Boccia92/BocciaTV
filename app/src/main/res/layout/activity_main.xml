<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101010">

    <!-- Background Image -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_dashboard"
        android:alpha="0.45" />

    <!-- Top Left Title & Clock -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_marginStart="20dp"
        android:layout_marginTop="16dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Boccia TV"
            android:textColor="@android:color/white"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="EEEE d MMMM, HH:mm"
            android:format24Hour="EEEE d MMMM, HH:mm"
            android:timeZone="Europe/Rome"
            android:textColor="@android:color/white"
            android:textSize="13sp"
            android:alpha="0.8" />
    </LinearLayout>

    <!-- Top Right: Info and Refresh -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentTop="true"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="16dp"
        android:gravity="end"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_exp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Scadenza: --/--/----"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_refresh"
                style="@style/MenuButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="Aggiorna Lista"
                android:textSize="11sp"/>

            <Button
                android:id="@+id/btn_settings"
                style="@style/MenuButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:text="Impostazioni"
                android:textSize="11sp"
                android:drawableStart="@drawable/ic_settings"
                android:drawablePadding="6dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"/>
        </LinearLayout>

    </LinearLayout>

    <!-- Central Menu -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_live"
            style="@style/MenuButtonStyle"
            android:layout_width="150dp"
            android:layout_height="120dp"
            android:text="LIVE TV"
            android:textSize="15sp"
            android:drawableTop="@drawable/ic_live"
            android:drawablePadding="8dp"
            android:paddingTop="14dp">
            <requestFocus />
        </Button>

        <Button
            android:id="@+id/btn_vod"
            style="@style/MenuButtonStyle"
            android:layout_width="150dp"
            android:layout_height="120dp"
            android:layout_marginStart="16dp"
            android:text="FILM"
            android:textSize="15sp"
            android:drawableTop="@drawable/ic_movie"
            android:drawablePadding="8dp"
            android:paddingTop="14dp"/>

        <Button
            android:id="@+id/btn_series"
            style="@style/MenuButtonStyle"
            android:layout_width="150dp"
            android:layout_height="120dp"
            android:layout_marginStart="16dp"
            android:text="SERIE TV"
            android:textSize="15sp"
            android:drawableTop="@drawable/ic_series"
            android:drawablePadding="8dp"
            android:paddingTop="14dp"/>

    </LinearLayout>

</RelativeLayout>
