<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Speed Test Connessione"
        android:textColor="@android:color/white"
        android:textSize="32sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp"/>

    <LinearLayout
        android:layout_width="500dp"
        android:layout_height="wrap_content"
        android:background="#22FFFFFF"
        android:padding="28dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <!-- Speed Display -->
        <TextView
            android:id="@+id/tv_speed_mbps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0.0 Mbps"
            android:textColor="#FFC107"
            android:textSize="48sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/pb_speed_test"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:max="100"
            android:progress="0" />

        <!-- Ping Display -->
        <TextView
            android:id="@+id/tv_ping_ms"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Latenza (Ping): -- ms"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:layout_marginBottom="12dp" />

        <!-- Quality Rating -->
        <TextView
            android:id="@+id/tv_quality_rating"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Qualità Streaming: Premi Avvia"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <!-- Start Button -->
        <Button
            android:id="@+id/btn_start_speed_test"
            style="@style/MenuButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="AVVIA SPEED TEST"
            android:textColor="#4CAF50"
            android:focusable="true"
            android:clickable="true"/>

    </LinearLayout>

    <Button
        android:id="@+id/btn_speed_test_back"
        style="@style/MenuButtonStyle"
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Torna Indietro"
        android:focusable="true"
        android:clickable="true"/>

</LinearLayout>
